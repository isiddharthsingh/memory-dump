{
  "expo": {
    "name": "memory-dump",
    "slug": "memory-dump",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "memorydump",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.siddharthsingh.memorydump",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Memory Dump",
        "NSCameraUsageDescription": "Not used.",
        "NSPhotoLibraryUsageDescription": "Not used.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.siddharthsingh.memorydump",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0C"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "text/*"
            },
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": "SUBQUERY(extensionItems,$extensionItem,SUBQUERY($extensionItem.attachments,$attachment,ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.url\" || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.text\" || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.image\" || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"com.adobe.pdf\" || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.file-url\").@count > 0).@count > 0",
          "androidIntentFilters": [
            "text/*",
            "application/pdf",
            "image/*"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Memory Dump to use the microphone so you can ask questions by voice.",
          "speechRecognitionPermission": "Allow Memory Dump to turn your voice into questions."
        }
      ],
      "./plugins/withPodDeploymentTarget"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
