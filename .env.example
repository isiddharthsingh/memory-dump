# Copy to .env and fill in real values.
# .env is gitignored.

# --- API auth (single-user) ---
# Generate with: openssl rand -hex 32
MEMORY_DUMP_API_TOKEN=replace-me-with-a-long-random-string

# --- Postgres ---
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_dump
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (for arq task queue) ---
REDIS_URL=redis://redis:6379/0

# --- AI providers ---
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# --- Models (override if needed) ---
CLAUDE_ANALYSIS_MODEL=claude-haiku-4-5-20251001
CLAUDE_SYNTHESIS_MODEL=claude-sonnet-4-6
CLAUDE_ASK_MODEL=claude-opus-4-7
VOYAGE_EMBED_MODEL=voyage-3-large
VOYAGE_RERANK_MODEL=rerank-2.5

# --- Logging ---
LOG_LEVEL=INFO
