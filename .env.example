# Copy to .env and fill in real values.
# .env is gitignored.

# --- Auth (SuperTokens) ---
# The core runs as the `supertokens` compose service. For a SuperTokens managed
# deployment, use its connection URI and API key instead.
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
# Required: generate with openssl rand -hex 32. Docker compose passes it to
# the core as API_KEYS, reading it like POSTGRES_* from your shell or
# backend/.env; compose won't start without it.
SUPERTOKENS_API_KEY=
# Public address of this API, as the app reaches it. The user dashboard is at
# $API_DOMAIN/auth/dashboard. The iOS build compiles it in as the app's server,
# so set it before building: https://<your domain> for a deployed server (App
# Transport Security needs https off the local network), or
# http://<your-mac>.local:8000 for a phone on the same Wi-Fi as this Mac.
API_DOMAIN=http://localhost:8000
# Set to false to lock signups (sign-in still works, and the dashboard can
# still create users).
ALLOW_SIGNUP=true
# The SuperTokens user dashboard at $API_DOMAIN/auth/dashboard. Off unless
# true: it's on the public address, and any dashboard login can change or
# delete every account. Turn it on only while you need it.
DASHBOARD_ENABLED=false

# --- Who runs this (the /privacy, /terms and /support pages) ---
# The app and App Store Connect link to $API_DOMAIN/privacy, /terms and
# /support. Set both before publishing: App Review wants a way to reach you.
OPERATOR_NAME=
SUPPORT_EMAIL=
# Whose laws the terms are under, e.g. "the State of New York, USA". Optional.
GOVERNING_LAW=
# Per-user hourly caps for the AI-spend endpoints, and sign-in/sign-up
# attempts per client address. 0 turns one off.
RATE_LIMIT_INGEST_PER_HOUR=60
RATE_LIMIT_ASK_PER_HOUR=120
RATE_LIMIT_SEARCH_PER_HOUR=600
RATE_LIMIT_AUTH_PER_HOUR=30
# Oldest app build (CFBundleVersion) still served; older ones get 426. 0 = any.
MIN_APP_BUILD=0
# Behind a proxy: the address its requests arrive from (for a proxy on the
# host reaching 127.0.0.1:8000, Docker's bridge gateway, e.g. 172.18.0.1), so
# uvicorn takes client addresses (for the sign-in limit) from X-Forwarded-For.
# Never *: anyone could then pick the address they're counted under.
# FORWARDED_ALLOW_IPS=172.18.0.1
# uvicorn worker processes for the api (production compose).
# WEB_CONCURRENCY=2

# --- Postgres ---
POSTGRES_USER=memory
# Required: generate with openssl rand -hex 32. Compose reads it, like
# SUPERTOKENS_API_KEY, from your shell or backend/.env and hands it to every
# service. It is set when the database volume is first created; to change it
# on an existing one, run ALTER USER first (see AGENTS.md).
POSTGRES_PASSWORD=
POSTGRES_DB=memory_dump
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Connections per process, and when Postgres ends a stuck statement or an
# idle transaction.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --- Redis (job queue, rate limits, caches) ---
# Required: generate with openssl rand -hex 32 (hex, so it fits in a URL).
# Compose reads it from your shell or backend/.env, starts Redis with it, and
# hands the api and worker REDIS_URL=redis://:<password>@redis:6379/0, which
# wins over REDIS_URL below. REDIS_URL is for an api or worker run outside
# compose.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- AI providers ---
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
# What an account may spend on the two keys above in a calendar month (UTC),
# in USD at list prices, before it needs a key of its own; 0 = no cap. An
# admin has none: docker compose exec api python -m app.admin you@example.com
FREE_MONTHLY_USD=3
# What an account on its own model key may spend of VOYAGE_API_KEY in a month
# (its own key can't embed); 0 = no cap. A Voyage key of its own, saved in
# Settings, lifts it.
VOYAGE_FREE_MONTHLY_USD=1
# Seals the provider keys users save in Settings (Anthropic, OpenAI, Gemini,
# OpenRouter, Bedrock) before they are stored. Generate with: openssl rand
# -hex 32. While it's empty the server takes no keys; changing it makes every
# saved key unreadable, and their owners save them again.
KEYS_SECRET=
# How often an account may save a key; each save asks the provider to check it.
RATE_LIMIT_KEYS_PER_HOUR=20

# --- Models (override if needed) ---
CLAUDE_ANALYSIS_MODEL=claude-haiku-5-5
CLAUDE_SYNTHESIS_MODEL=claude-sonnet-5-5
CLAUDE_ASK_MODEL=claude-opus-5-5
VOYAGE_EMBED_MODEL=voyage-3-large
VOYAGE_RERANK_MODEL=rerank-2.5
# Timeouts, and calls in flight per provider across all processes (0 = no cap).
ANTHROPIC_TIMEOUT_S=300
ASK_TIMEOUT_S=60
VOYAGE_TIMEOUT_S=30
ANTHROPIC_MAX_CONCURRENCY=16
VOYAGE_MAX_CONCURRENCY=16
# Saving a link: how long fetching it may take, and the largest page read.
EXTRACT_TIMEOUT_S=90
EXTRACT_MAX_BYTES=5242880

# --- Upload storage ---
# Uploaded images and PDFs are kept, each with a thumbnail. "s3" keeps them in
# an S3-compatible bucket: by default the compose stack's SeaweedFS, or S3, R2
# or MinIO. The bucket is the app's alone, since files whose item is gone are
# swept from it, and must have no lifecycle rule that expires objects (older
# setups were told to add one): it would delete the kept files. "local" keeps
# them in the uploads volume the api and worker share (one host).
STORAGE_BACKEND=s3
S3_BUCKET=memory-dump
S3_ENDPOINT_URL=http://seaweedfs:8333
# S3_REGION=
# Generate each with: openssl rand -hex 20. Docker compose hands them to
# SeaweedFS as its admin key pair, reading them like POSTGRES_* from your shell
# or backend/.env, so set them there too; it won't start without them.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Push (APNs) ---
# Token-based auth key (.p8) from developer.apple.com → Keys. Put the file in
# secrets/ at the repo root (gitignored); the worker mounts it at /run/secrets.
# Leave APNS_KEY_PATH empty to skip pushes.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.siddharthsingh.memorydump

# --- Logging and monitoring ---
LOG_LEVEL=INFO
# json for log collectors, console for reading in a terminal.
LOG_FORMAT=json
# Errors go to Sentry when set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# /metrics answers only with Authorization: Bearer <token>; off while empty.
METRICS_TOKEN=
WORKER_METRICS_PORT=9100
# The most memory the worker container may use (docker compose mem_limit).
# WORKER_MEM_LIMIT=4g
